{
  "name": "red-sea-tourism",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.22.2 <23", "npm": ">=10.9.7 <11"},
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests scripts next.config.ts playwright.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/database",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:concurrency": "vitest run tests/concurrency",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "i18n:check": "node scripts/i18n-check.mjs",
    "verify:production": "tsx scripts/verify-production-config.ts",
    "verify:release": "tsx scripts/verify-release-config.ts",
    "api:spec": "tsx scripts/generate-openapi.ts",
    "worker": "tsx scripts/run-worker.ts",
    "db:start": "node scripts/db-start.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:types": "node scripts/db-types.mjs",
    "db:drift": "node scripts/db-types.mjs --check",
    "browser:agent": "node .tooling/node_modules/@playwright/cli/playwright-cli.js"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "dotenv": "18.0.8",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
